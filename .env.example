# Скопируйте в .env и при необходимости измените. Секреты — только в .env (он в .gitignore).
NC_ENV=dev
NC_LOG__LEVEL=INFO
NC_LOG__JSON_FORMAT=false

# Локальная LLM (Ollama). Для слабого ПК: qwen3:4b
NC_LLM__ENABLED=true
NC_LLM__BASE_URL=http://localhost:11434
NC_LLM__MODEL=qwen3:8b
# NC_LLM__PROVIDER=openai_compatible
# NC_LLM__API_KEY=

NC_EMBEDDINGS__BASE_URL=http://localhost:11434
NC_EMBEDDINGS__MODEL=bge-m3

# Векторная БД: пусто — встроенный Qdrant в data/vectors; в продакшене — сервер
# NC_VECTOR_STORE__URL=http://localhost:6333
# NC_VECTOR_STORE__API_KEY=

# Очередь: inline (разработка) или arq (Redis + `normocontrol worker`)
NC_JOBS__BACKEND=inline
NC_JOBS__REDIS_URL=redis://localhost:6379/0

NC_API__CORS_ORIGINS=["http://localhost:3000"]
NC_API__MAX_UPLOAD_MB=20
